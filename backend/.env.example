DB_HOST=localhost
DB_PORT=5432
DB_NAME=evoting_db
DB_USER=evoting_app
DB_PASSWORD=change-me

REDIS_URL=redis://127.0.0.1:6379

OTP_SECRET=change-this-to-a-random-secret-at-least-16-chars

# Master key for encrypting private keys at rest (AES-256: 32 bytes hex/base64 or string).
# In development, if omitted, a key derived from OTP_SECRET is used.
# In production, MASTER_KEY must be explicitly configured.
MASTER_KEY=

#ptional in development; required outside development. Uses SMTP with STARTTLS (usually port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PORT=3000
APP_ENV=development
FRONTEND_DIR=../frontend

#only emails on this domain (or its subdomains like mail.ugm.ac.id) can be added as participants
ALLOWED_EMAIL_DOMAIN=ugm.ac.id

# Per-IP rate limits (login, OTP, QR, public verify) stay OFF until you say how
# browsers reach this server, because the Next.js frontend does not forward the
# real client address and one shared limit would lock every voter out.
#   unset -> per-IP limits off (per-account limits are always on)
#   0     -> browsers connect to this server directly; the TCP address is used
#   1     -> one reverse proxy in front (nginx, Caddy, a load balancer) that
#            appends the client address to X-Forwarded-For; add 1 per extra proxy
# Never set 1 or more unless such a proxy really is in front, or clients can forge it.
# TRUSTED_PROXY_HOPS=1
