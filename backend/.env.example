DB_HOST=localhost
DB_PORT=5432
DB_NAME=evoting_db
DB_USER=evoting_app
DB_PASSWORD=change-me

REDIS_URL=redis://127.0.0.1:6379

OTP_SECRET=change-this-to-a-random-secret-at-least-16-chars

# Master key for encrypting private keys at rest (AES-256: 32 bytes hex/base64 or string).
# In development, if omitted, a key derived from OTP_SECRET is used.
# In production, MASTER_KEY must be explicitly configured.
MASTER_KEY=

#ptional in development; required outside development. Uses SMTP with STARTTLS (usually port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PORT=3000
APP_ENV=development
FRONTEND_DIR=../frontend

#only emails on this domain (or its subdomains like mail.ugm.ac.id) can be added as participants
ALLOWED_EMAIL_DOMAIN=ugm.ac.id

# Google sign-in (OAuth 2.0 / OpenID Connect). Leave all three blank to disable
# it; the /api/auth/google routes are only registered when it is configured.
# Create the client at https://console.cloud.google.com/apis/credentials as a
# "Web application" and register this exact Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
